# Backend (prefix PIANO_)
PIANO_ENV=development
PIANO_DATABASE_URL=DATABASE_URL=postgresql+psycopg://piano:YourPasswordHere@localhost:5432/pianomode
PIANO_REDIS_URL=redis://redis:6379/0
PIANO_SECRET_KEY=change-me-in-production
PIANO_CORS_ORIGINS=["http://localhost:3000"]
PIANO_PUBLIC_WEB_URL=http://localhost:3000
PIANO_RATE_LIMIT_BACKEND=redis
# Production: set PIANO_ENV=production, a long random PIANO_SECRET_KEY, and use HTTPS
# (cookies become Secure automatically).
PIANO_STORAGE_DIR=/data/storage
# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://api:8000

# Billing (Paystack). Get the secret key from Paystack Dashboard > Settings > API Keys.
# Use the sk_test_ key while testing; the app refuses to start in production without one.
PIANO_PAYSTACK_SECRET_KEY=
# Free trial for new individual accounts, in days (0 = no trial)
PIANO_TRIAL_DAYS=7

# Email (Resend). Create an API key at resend.com/api-keys and verify your sending domain at
# resend.com/domains. Until a domain is verified Resend only delivers to your own address.
PIANO_RESEND_API_KEY=
PIANO_EMAIL_FROM=Piano Platform <hello@yourdomain.com>

# Production only (see .env.production.example and docs/deployment.md)
# Number of reverse proxies in front of the API (Caddy = 1). 0 in development.
PIANO_TRUSTED_PROXIES=0
# Error reports (sentry.io). Leave empty to turn off.
PIANO_SENTRY_DSN=
# Shown on the Terms / Privacy / Refunds pages (set when building the web image)
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_COMPANY_NAME=

# My Library limits per person (defaults shown)
# PIANO_LIBRARY_MAX_ITEMS=200
# PIANO_LIBRARY_MAX_FILE_BYTES=5242880
# PIANO_LIBRARY_MAX_TOTAL_BYTES=104857600

# Administrators must use two-factor sign-in to open admin tools. Default: on in production, off
# otherwise. Set true/false to override.
# PIANO_ADMIN_REQUIRE_TWO_FACTOR=true
# Password hashes run at once per server process (each holds ~19 MB). About the number of CPU cores.
# PIANO_MAX_CONCURRENT_HASHES=4

# Automatic card renewal (opt-in per person; see docs/adr/0016-automatic-renewal.md)
# PIANO_AUTO_RENEWAL_ENABLED=false
